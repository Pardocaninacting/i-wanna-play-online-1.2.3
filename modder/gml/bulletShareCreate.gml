/// ONLINE
// Proxy bullet Create: all fields are set by @bullet_apply on creation; these
// defaults only guard against an uninitialised read before the first snapshot
// (GMS errors on undefined instance variables).
@bOwner = "";
@bKey = "";
@bWorld = noone;
@bAlive = 4;
@bImg = 0;
@bSlot = -1;
@bAngle = 0;
