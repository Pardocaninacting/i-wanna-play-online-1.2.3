# Whitelist approach: ignore everything, then allow only the project directories
*

# Top-level files to include
!.gitignore
!LICENSE
!README.md

# Project directories
!modder/
!modder/**
!converter-gms/
!converter-gms/**
!server/
!server/**
!iwpo-website/
!iwpo-website/**

# UndertaleModTool (git submodule)
!.gitmodules
!UndertaleModTool

# Local dev workspace (never shipped)
_workspace/
